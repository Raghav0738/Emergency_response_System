{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageDemoTablesWithoutDeleting",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:939423308052:table/CampusMedicalDemo-*"
    },
    {
      "Sid": "ManageDemoSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "secretsmanager:UpdateSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:939423308052:secret:ApplicationSecret25AD4F13-*",
        "arn:aws:secretsmanager:ap-south-1:939423308052:secret:BootstrapAdminA3E453FC-*"
      ]
    },
    {
      "Sid": "GenerateDemoSecretValues",
      "Effect": "Allow",
      "Action": "secretsmanager:GetRandomPassword",
      "Resource": "*"
    },
    {
      "Sid": "ManageDemoLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:939423308052:function:CampusMedicalDemo-*"
    },
    {
      "Sid": "ManageDemoApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:DELETE",
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:POST",
        "apigateway:PUT"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-south-1::/apis",
        "arn:aws:apigateway:ap-south-1::/apis/*",
        "arn:aws:apigateway:ap-south-1::/tags/*"
      ]
    },
    {
      "Sid": "ManageDemoApiStages",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": [
        "arn:aws:apigateway:ap-south-1::/apis/*/stages",
        "arn:aws:apigateway:ap-south-1::/apis/*/stages/*"
      ]
    },
    {
      "Sid": "ManageDemoLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DeleteRetentionPolicy",
        "logs:DescribeLogGroups",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:aws:logs:ap-south-1:939423308052:log-group:CampusMedicalDemo-*"
    },
    {
      "Sid": "ManageDemoLambdaRole",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::939423308052:role/CampusMedicalDemo-*"
    },
    {
      "Sid": "RequireLambdaPermissionsBoundaryOnRoleCreation",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::939423308052:role/CampusMedicalDemo-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::939423308052:policy/CampusMedicalDemoLambdaBoundary"
        }
      }
    },
    {
      "Sid": "PassOnlyDemoLambdaRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::939423308052:role/CampusMedicalDemo-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadCDKBootstrapVersion",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:ap-south-1:939423308052:parameter/cdk-bootstrap/hnb659fds/version"
    }
  ]
}
